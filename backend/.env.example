# Copy this file to .env and enter credentials issued by each provider.
SOCIAL_LOGIN_ENABLED=false
FRONTEND_ORIGIN=http://localhost:5173
DB_URL=jdbc:postgresql://localhost:5433/caltalk
DB_USERNAME=caltalk
DB_PASSWORD=caltalk-local-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CHATBOT_ENABLED=false
KAKAO_CHATBOT_SKILL_SECRET=
KAKAO_IDENTITY_HMAC_SECRET=
KAKAO_LOGICAL_BOT_KEY=caltalk-main

# Local-first natural-language scheduling
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=8s
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT=8s
OPENAI_HOURLY_LIMIT=20

# PWA Web Push (generate once and keep private key secret)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
