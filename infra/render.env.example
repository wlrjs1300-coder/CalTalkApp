# Backend Private Service (keep 8080; Render private networking reserves port 10000.)
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<render-postgres-internal-host>:5432/<database>
DB_USERNAME=<render-postgres-user>
DB_PASSWORD=<set-in-render-dashboard>
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://caltalk.<main-domain>
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Frontend Web Service (Render supplies PORT at runtime.)
BACKEND_ORIGIN=http://<render-private-service-host>:8080
VITE_API_BASE_URL=
