# Backend Private Service (keep 8080; Render private networking reserves port 10000.)
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<render-postgres-internal-host>:5432/<database>
DB_USERNAME=<render-postgres-user>
DB_PASSWORD=<set-in-render-dashboard>
REDIS_URL=redis://<render-key-value-internal-host>:6379
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://caltalk.<main-domain>
FRONTEND_ORIGIN=https://caltalk.<main-domain>
SOCIAL_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
KAKAO_CLIENT_ID=<kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<kakao-client-secret>
NAVER_CLIENT_ID=<naver-client-id>
NAVER_CLIENT_SECRET=<naver-client-secret>
KAKAO_CHATBOT_ENABLED=true
KAKAO_CHATBOT_SKILL_SECRET=<same-secret-configured-in-kakao-skill-header>
KAKAO_IDENTITY_HMAC_SECRET=<generate-a-long-random-secret>
KAKAO_LOGICAL_BOT_KEY=caltalk-main
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=8s
OPENAI_FALLBACK_ENABLED=true
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT=8s
OPENAI_HOURLY_LIMIT=20
WEB_PUSH_VAPID_PUBLIC_KEY=<same-public-key-used-by-the-installed-pwa>
WEB_PUSH_VAPID_PRIVATE_KEY=<matching-private-key>
WEB_PUSH_VAPID_SUBJECT=mailto:<operator-email>
WEB_PUSH_DISPATCH_INTERVAL=30000
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Frontend Web Service (Render supplies PORT at runtime.)
BACKEND_ORIGIN=http://<render-private-service-host>:8080
VITE_API_BASE_URL=
